CREATE TABLE IF NOT EXISTS DownloadedFileNew (
    googleDriveId TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    fileSizeInMB INTEGER NOT NULL,
    timeInSeconds INTEGER NOT NULL,
    largerThan100MB INTEGER NOT NULL,
    show TEXT
);

INSERT INTO DownloadedFileNew (googleDriveId, title, fileSizeInMB, timeInSeconds, largerThan100MB)
    SELECT googleDriveId, title, fileSizeInMB, timeInSeconds, largerThan100MB FROM DownloadedFile;

DROP TABLE DownloadedFile;

ALTER TABLE DownloadedFileNew RENAME TO DownloadedFile;
